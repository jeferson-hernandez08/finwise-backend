# ============================================================
# FinWise - variables de entorno del backend (NestJS)
# Copia este archivo como `.env` y rellena los valores reales.
# El archivo `.env` esta en .gitignore: nunca se sube al repositorio.
# ============================================================

# --- Base de datos -------------------------------------------
# Cadena de conexion de MongoDB (Atlas o local).
# Ejemplo local:  mongodb://127.0.0.1:27017/finwise_db
# Ejemplo Atlas:  mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/finwise_db?retryWrites=true&w=majority
# Obligatoria: si falta, la API no arranca.
MONGODB_URI=

# --- Autenticacion JWT ---------------------------------------
# Clave con la que se firman los tokens. Usa una cadena larga y aleatoria.
JWT_SECRET=
# Vigencia del token: 60s, 30m, 7d, 30d...
JWT_EXPIRATION=7d

# --- Servidor -------------------------------------------------
# Puerto en el que escucha la API (el frontend apunta al 3000).
PORT=3000
# Origen del frontend Angular: se usa para CORS y para el redirect de Google.
FRONTEND_URL=http://localhost:4200

# --- Google OAuth ---------------------------------------------
# Credenciales de la consola de Google Cloud (APIs y servicios > Credenciales).
# Si se dejan vacias la API arranca igual, pero el boton "Entrar con Google" no funcionara.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con la URI de redireccion autorizada en Google Cloud.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
